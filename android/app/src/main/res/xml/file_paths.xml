<?xml version="1.0" encoding="utf-8"?>
<!-- הנתיבים ש-FileProvider מורשה לשתף החוצה. משמש להעברת ה-APK שהורדנו
     למתקין המערכת (content:// במקום file://). cache-path מכסה את
     RNFS.CachesDirectoryPath שאליו מורידים את קובץ העדכון. -->
<paths>
    <cache-path name="cache" path="." />
    <files-path name="files" path="." />
    <external-cache-path name="ext_cache" path="." />
    <external-files-path name="ext_files" path="." />
</paths>
