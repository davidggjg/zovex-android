# ======================================================================
#  זובקס — הגדרות לשרת ייעודי (18 ליבות, לא רץ עליו שום דבר אחר)
#  העתק לקובץ .env ומלא את הערכים המסומנים
# ======================================================================

# ---------- טלגרם ----------
# מ-https://my.telegram.org  ->  API development tools
TG_API_ID=
TG_API_HASH=
TG_SESSION=zovexsub
TRIGGER=.srt

# ---------- מפתחות API ----------
# כל מפתח = חשבון נפרד עם מכסה משלו. יותר מפתחות = יותר עבודה במקביל.
# Groq:   https://console.groq.com/keys
# Gemini: https://aistudio.google.com/apikey
GROQ_API_KEYS=
GEMINI_API_KEYS=

PARALLEL_CEILING=16
# STT_PARALLEL=0        # 0 = לפי מספר מפתחות Groq
# TRANSLATE_PARALLEL=0  # 0 = לפי מספר מפתחות Gemini

# ---------- מודלים ----------
GROQ_STT_MODEL=whisper-large-v3
GROQ_STT_FALLBACK=whisper-large-v3-turbo
STT_ATTEMPTS=10
GEMINI_FALLBACK_STT=1
GEMINI_MODEL=gemini-pro-latest
GEMINI_FALLBACK_MODEL=gemini-flash-latest
GEMINI_LAST_RESORT_MODEL=gemini-flash-lite-latest
RESEARCH_TIMEOUT=180

# ---------- מעבד: שרת ייעודי, בלי רחמים ----------
# מסנן הכתוביות של ffmpeg רץ בחוט אחד, ולכן תהליך יחיד לא מצליח להעסיק
# מכונה גדולה. הצריבה מפוצלת לקטעים ולכל קטע תהליך משלו.
BURN_SEGMENTS=0                # 0 = לפי מספר הליבות (18 ליבות -> 6 קטעים)
BURN_SEGMENT_THREADS=3         # חוטים לכל קטע. 6 קטעים x 3 = 18 ליבות
BURN_SEGMENTS_MAX=8
BURN_PARALLEL_MIN_MINUTES=3    # מתחת לזה לא שווה לפצל

BURN_THREADS=18                # לנתיב התהליך היחיד, אם הפיצול לא זמין
BURN_THREADS_MAX=18
RESERVE_CORES=0                # אין למי לשמור
FFMPEG_THREADS=4               # חילוץ אודיו וזיהוי דיבור
NICE=0                         # בלי הנמכת עדיפות

# ---------- צריבה ----------
BURN_PROFILE=auto              # quick מתחת לסף, H.265 מעליו
QUICK_UNDER_MB=1024            # עד ג'יגה - קידוד מהיר (H.264 ultrafast)
SMALL_OVER_MB=3072
UPLOAD_CEILING_MB=3800
BURN_MAX_MINUTES=150           # עד שעתיים וחצי
BURN_TIMEOUT=auto              # תקרת זמן לפי אורך הווידאו
BURN_TIMEOUT_FACTOR=4
BURN_MAX_HEIGHT=1080           # תקרה בלבד; מקור נמוך יותר לא מוגדל
UPLOAD_LIMIT_MB=0              # 0 = CRF טהור, בלי תקרת bitrate

# ---------- קרדיט פתיחה ----------
CREDIT_TEXT=עלה וקודד על ידי|zovex|ועולם הדרמות הטורקיות
CREDIT_SECONDS=10
CREDIT_SIZE=34

# ---------- העברות וקבצים ----------
TG_CONNECTIONS=4               # בקשות במקביל מול טלגרם
FETCH_FORMAT=bestvideo[height<=1080]+bestaudio/best[height<=1080]/best
FETCH_CONNECTIONS=4
MAX_INPUT_MINUTES=180
WORK_DIR=/tmp/zovexsub
DISK_FACTOR=2.5
DISK_RESERVE_GB=3
LOG_LEVEL=INFO
