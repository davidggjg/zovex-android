# ---- Telegram userbot (my.telegram.org -> API development tools) ----
TG_API_ID=0
TG_API_HASH=
# שם קובץ הסשן. בהרצה ראשונה הבוט יבקש מספר טלפון + קוד (והתחברות דו-שלבית אם יש)
TG_SESSION=zovexsub

# קובץ המורשים - מנוהל מתוך טלגרם בפקודות .srt הוסף / .srt הסר / .srt רשימה
# ALLOWLIST_FILE=/opt/zovexsub/bot/allowlist.json
# פקודת הפעלה בצ'אט
TRIGGER=.srt

# ---- מפתחות API (אפשר כמה, מופרדים בפסיק - נעשה round-robin) ----
GROQ_API_KEYS=gsk_xxx,gsk_yyy
GEMINI_API_KEYS=AQ.xxx,AQ.yyy

# ---- מודלים ----
GROQ_STT_MODEL=whisper-large-v3
GEMINI_MODEL=gemini-pro-latest
GEMINI_FALLBACK_MODEL=gemini-flash-latest
GEMINI_LAST_RESORT_MODEL=gemini-flash-lite-latest
# שים לב: מפתחות חינמיים חסומים ממודלי pro (limit: 0), והקוד יורד אוטומטית ל-flash

# ---- מגבלות שרת ----
MAX_INPUT_MINUTES=180          # אורך מקסימלי לתמלול
BURN_MAX_MINUTES=10            # צריבה רק עד כאן
# פרופיל צריבה. auto בוחר לפי גודל המקור ואורכו:
#   מקור קטן   -> quick    (H.264 ultrafast) - מהיר מאוד, קובץ גדול, וזה בסדר
#   מקור בינוני -> balanced (H.265 veryfast)  - חצי מהגודל
#   מקור גדול   -> small    (H.265 medium)    - הקטן ביותר, הכי כבד
# אחרי הבחירה נבדק שהפלט הצפוי נכנס במגבלת ההעלאה, ואם לא יורדים דרגה.
# אפשר גם לקבע פרופיל: quick / fast / balanced / small
BURN_PROFILE=auto
QUICK_UNDER_MB=300             # מתחת לזה - קידוד מהיר (נמוך בכוונה: ראה README)
SMALL_OVER_MB=3072             # מעל זה - הדחוס ביותר
UPLOAD_CEILING_MB=3800         # תקרת ההעלאה שלפיה נבדק הפלט הצפוי
# דריסות נקודתיות, אם צריך:
# BURN_CODEC=libx265
# BURN_PRESET=veryfast
# BURN_CRF=30
# BURN_PIX_FMT=yuv420p
UPLOAD_LIMIT_MB=0              # 0 = CRF טהור (מומלץ). ערך גדול מאפס מפעיל תקרת bitrate
BURN_MAX_HEIGHT=1080           # תקרה בלבד: מקור נמוך יותר נשאר כמו שהוא. 0 = בלי נגיעה ברזולוציה
FFMPEG_THREADS=1               # לחילוץ אודיו וזיהוי דיבור - זול ממילא
BURN_THREADS=auto              # לפי העומס בשרת ברגע שהצריבה מתחילה
RESERVE_CORES=1.5              # ליבות שנשארות פנויות לשאר השרת
BURN_THREADS_MAX=0             # תקרה, 0 = עד כל הליבות
BURN_TIMEOUT=1800              # תקרה קשיחה לצריבה בשניות (חצי שעה)
TG_CONNECTIONS=4               # בקשות במקביל מול טלגרם (הורדה והעלאה)
WORK_DIR=/tmp/zovexsub          # נמחקת אחרי כל עבודה ובכל הפעלה
LOG_LEVEL=INFO                 # DEBUG מראה כל הודעה שנכנסת
NICE=15                        # עדיפות CPU נמוכה לתהליכי ffmpeg
